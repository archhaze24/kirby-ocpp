{
  "openapi": "3.1.0",
  "info": {
    "title": "kirby-csms HTTP API",
    "version": "1.0.0",
    "description": "Version 1 of the kirby-csms control API. Bearer authentication is required only when configured by the server. HEAD is implied for GET routes; OPTIONS is handled for every listed path. The server refuses browser requests by design."
  },
  "servers": [{ "url": "http://127.0.0.1:9100", "description": "Example loopback listener; the configured listener may use HTTPS." }],
  "security": [{ "bearerAuth": [] }, {}],
  "paths": {
    "/v1": { "get": { "operationId": "getIndex", "summary": "List API resources", "responses": { "200": { "description": "API index", "content": { "application/json": { "schema": { "type": "object", "properties": { "api_version": { "const": 1 }, "version": { "type": "string" }, "resources": { "type": "array", "items": { "type": "object", "properties": { "path": { "type": "string" }, "methods": { "type": "array", "items": { "type": "string" } } }, "required": ["path", "methods"] } } }, "required": ["api_version", "version", "resources"] } } } } } } },
    "/v1/health": { "get": { "operationId": "getHealth", "responses": { "200": { "description": "Health and station count", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } } } } },
    "/v1/stations": { "get": { "operationId": "listStations", "responses": { "200": { "description": "Stations", "content": { "application/json": { "schema": { "type": "object", "properties": { "stations": { "type": "array", "items": { "$ref": "#/components/schemas/Station" } } }, "required": ["stations"] } } } } } } },
    "/v1/stations/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/StationId" }],
      "get": { "operationId": "getStation", "responses": { "200": { "description": "Station and protocol-specific state", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Station" }, { "type": "object", "properties": { "state": { "type": ["object", "null"], "description": "Protocol-specific station state; keys depend on the negotiated protocol." } }, "required": ["state"] }] } } } }, "404": { "$ref": "#/components/responses/Error" } } },
      "delete": { "operationId": "forgetStation", "responses": { "200": { "description": "Station forgotten", "content": { "application/json": { "schema": { "type": "object", "properties": { "station": { "type": "string" }, "forgotten": { "const": true } }, "required": ["station", "forgotten"] } } } }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/stations/{id}/history": { "parameters": [{ "$ref": "#/components/parameters/StationId" }], "get": { "operationId": "getStationHistory", "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 0 } }, { "name": "since", "in": "query", "description": "Cursor from an earlier answer, such as c42.", "schema": { "type": "string", "pattern": "^c[0-9]+$" } }, { "name": "action", "in": "query", "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }, { "name": "kind", "in": "query", "schema": { "enum": ["call", "result", "error"] } }, { "name": "direction", "in": "query", "schema": { "enum": ["in", "out"] } }, { "name": "format", "in": "query", "schema": { "enum": ["json", "ndjson", "csv"] } }], "responses": { "200": { "description": "Station history", "content": { "application/json": { "schema": { "type": "object", "properties": { "station": { "type": "string" }, "frames": { "type": "array", "items": { "type": "object", "additionalProperties": true } }, "next_cursor": { "type": ["string", "null"] }, "gap": { "type": "boolean" } }, "required": ["station", "frames", "next_cursor", "gap"] } }, "application/x-ndjson": { "schema": { "type": "string" } }, "text/csv": { "schema": { "type": "string" } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/v1/transactions": { "get": { "operationId": "listTransactions", "parameters": [{ "name": "station", "in": "query", "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }, { "name": "state", "in": "query", "schema": { "enum": ["active", "stopped"] } }, { "name": "since", "in": "query", "description": "RFC 3339 timestamp.", "schema": { "type": "string", "format": "date-time" } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 0, "maximum": 10000 } }, { "name": "format", "in": "query", "schema": { "enum": ["json", "csv"] } }], "responses": { "200": { "description": "Transactions", "content": { "application/json": { "schema": { "type": "object", "properties": { "transactions": { "type": "array", "items": { "type": "object", "additionalProperties": true } }, "truncated": { "type": "boolean" } }, "required": ["transactions", "truncated"] } }, "text/csv": { "schema": { "type": "string" } } } } } } },
    "/v1/metrics": { "get": { "operationId": "getMetrics", "responses": { "200": { "description": "Prometheus text exposition", "content": { "text/plain; version=0.0.4": { "schema": { "type": "string" } } } } } } },
    "/v1/calls": {"post": {"operationId": "sendBulkCall", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BulkCall"}}}}, "responses": {"200": {"description": "Per-station call outcomes", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BulkResponse"}}}}, "400": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}}}},
    "/v1/stations/{id}/calls": { "parameters": [{ "$ref": "#/components/parameters/StationId" }], "post": { "operationId": "sendStationCall", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CallRequest" } } } }, "responses": { "200": { "description": "OCPP call outcome, including protocol errors and timeouts", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/v1/stations/{id}/rules": { "parameters": [{ "$ref": "#/components/parameters/StationId" }], "get": { "operationId": "listStationRules", "responses": { "200": { "description": "Station rules", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } } } } },
    "/v1/stations/{id}/rules/{action}": {
      "parameters": [{ "$ref": "#/components/parameters/StationId" }, { "$ref": "#/components/parameters/Action" }],
      "get": { "operationId": "getStationRule", "responses": { "200": { "description": "Station rule", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "404": { "$ref": "#/components/responses/Error" } } },
      "put": { "operationId": "setStationRule", "parameters": [{ "$ref": "#/components/parameters/Protocol" }], "requestBody": { "$ref": "#/components/requestBodies/RulePayload" }, "responses": { "200": { "description": "Rule set", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } },
      "delete": { "operationId": "deleteStationRule", "responses": { "200": { "description": "Rule removed when present", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "400": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/events": { "get": { "operationId": "streamEvents", "parameters": [{ "name": "station", "in": "query", "schema": { "type": "string" } }, { "name": "last_event_id", "in": "query", "description": "Alternative to the Last-Event-ID header.", "schema": { "type": "string" } }, { "name": "Last-Event-ID", "in": "header", "schema": { "type": "string" } }], "responses": { "200": { "description": "Server-sent event stream", "content": { "text/event-stream": { "schema": { "type": "string" } } } }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/v1/rules": { "get": { "operationId": "listRules", "responses": { "200": { "description": "Global rules", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } } } } },
    "/v1/rules/{action}": {
      "parameters": [{ "$ref": "#/components/parameters/Action" }],
      "put": { "operationId": "setRule", "parameters": [{ "$ref": "#/components/parameters/Protocol" }], "requestBody": { "$ref": "#/components/requestBodies/RulePayload" }, "responses": { "200": { "description": "Rule set", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } },
      "delete": { "operationId": "deleteRule", "parameters": [{ "$ref": "#/components/parameters/Protocol" }], "responses": { "200": { "description": "Rule removed when present", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "400": { "$ref": "#/components/responses/Error" } } }
    },
    "/v1/faults": {
      "get": { "operationId": "listFaults", "responses": { "200": { "description": "Stored faults", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } } } },
      "post": { "operationId": "injectFault", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FaultRequest" } } } }, "responses": { "200": { "description": "Fault injected", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } },
      "delete": { "operationId": "clearFaults", "responses": { "200": { "description": "All faults cleared", "content": { "application/json": { "schema": { "type": "object", "properties": { "remaining": { "const": 0 } }, "required": ["remaining"] } } } } } }
    },
    "/v1/faults/{id}": { "parameters": [{ "$ref": "#/components/parameters/FaultId" }], "delete": { "operationId": "deleteFault", "responses": { "200": { "description": "Fault removed if still present", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" }, "removed": { "type": "boolean" } }, "required": ["id", "removed"] } } } } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "parameters": {
      "StationId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 128 } },
      "Action": { "name": "action", "in": "path", "required": true, "schema": { "type": "string" } },
      "FaultId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
      "Protocol": { "name": "protocol", "in": "query", "schema": { "type": "string" } }
    },
    "requestBodies": { "RulePayload": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } } },
    "responses": { "Error": { "description": "API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } },
    "schemas": {
      "Error": { "type": "object", "properties": { "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } }, "required": ["code", "message"] } }, "required": ["error"] },
      "Health": { "type": "object", "properties": { "ok": { "const": true }, "api_version": { "const": 1 }, "version": { "type": "string" }, "stations": { "type": "integer", "minimum": 0 } }, "required": ["ok", "api_version", "version", "stations"] },
      "Station": {"type": "object", "description": "Protocol-neutral station summary; transaction identifiers and connector keys are opaque strings.", "properties": {"id": {"type": "string"}, "connected": {"type": "boolean"}, "protocol": {"type": ["string", "null"]}, "received_calls": {"type": "integer", "minimum": 0}, "remote_addr": {"type": ["string", "null"]}, "vendor": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "connectors": {"type": "object", "additionalProperties": {"type": "string"}}, "active_transactions": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "connector": {"type": ["integer", "string"], "description": "Connector identifier in the station protocol; an integer in OCPP 1.6."}, "evse": {"type": ["integer", "string", "null"], "description": "EVSE identifier in the station protocol; null in OCPP 1.6."}}, "required": ["id", "connector", "evse"]}}, "security_events": {"type": "integer", "minimum": 0}}, "required": ["id", "connected", "protocol", "received_calls", "remote_addr", "vendor", "model", "connectors", "active_transactions", "security_events"]},
      "CallRequest": {"type": "object", "properties": {"action": {"type": "string", "minLength": 1}, "payload": {"description": "OCPP payload JSON value; defaults to an empty object.", "default": {}}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}}, "required": ["action"], "additionalProperties": true},
      "BulkOutcome": {"type": "object", "properties": {"station": {"type": "string"}, "protocol": {"type": ["string", "null"]}, "outcome": {"enum": ["result", "call_error", "timeout", "error"]}, "ok": {"type": "boolean"}, "result": {}, "error": {"type": ["object", "null"], "properties": {"code": {"type": "string"}, "message": {"type": "string", "maxLength": 1024}}, "required": ["code", "message"]}, "code": {"type": ["string", "null"], "maxLength": 128}, "details": {}}, "required": ["station", "protocol", "outcome", "ok", "result", "error", "code", "details"]},
      "BulkResponse": {"type": "object", "properties": {"action": {"type": "string"}, "results": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/BulkOutcome"}}}, "required": ["action", "results"]},
      "BulkCall": {"type": "object", "properties": {"station": {"type": "string", "minLength": 1, "description": "1 to 128 UTF-8 bytes without control or bidirectional characters. Whole-id glob with * and ?.", "maxLength": 128}, "protocol": {"type": ["string", "null"]}, "action": {"type": "string", "minLength": 1, "maxLength": 128, "description": "1 to 128 UTF-8 bytes without control or bidirectional characters."}, "payload": {"description": "OCPP payload JSON value; defaults to an empty object.", "default": {}}, "timeout_ms": {"type": ["integer", "null"], "minimum": 1, "maximum": 86400000}}, "required": ["station", "action"], "additionalProperties": false},
      "FaultRequest": { "type": "object", "properties": { "action": { "type": "string", "minLength": 1, "maxLength": 128 }, "kind": { "enum": ["call_error", "silence", "close", "invalid_payload"] }, "payload": { "description": "Required with invalid_payload; interpreted as a JSON value." }, "times": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 1 }, "station": { "type": "string", "minLength": 1, "maxLength": 128 }, "protocol": { "type": "string" } }, "required": ["action", "kind"], "additionalProperties": false }
    }
  }
}
